{
  "name": "@cgentai/cgent-protocol",
  "version": "1.0.10",
  "description": "Cgent.AI Commerce Protocol",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./types/order": {
      "types": "./dist/types/order.d.ts",
      "import": "./dist/types/order.mjs",
      "require": "./dist/types/order.js"
    },
    "./types/product": {
      "types": "./dist/types/product.d.ts",
      "import": "./dist/types/product.mjs",
      "require": "./dist/types/product.js"
    },
    "./specs": {
      "types": "./dist/specs/index.d.ts",
      "import": "./dist/specs/index.mjs",
      "require": "./dist/specs/index.js"
    },
    "./specs/common": {
      "types": "./dist/specs/common/index.d.ts",
      "import": "./dist/specs/common/index.mjs",
      "require": "./dist/specs/common/index.js"
    },
    "./specs/common/zod-schemas": {
      "types": "./dist/specs/common/zod-schemas.d.ts",
      "import": "./dist/specs/common/zod-schemas.mjs",
      "require": "./dist/specs/common/zod-schemas.js"
    },
    "./specs/verticals/apparel/tshirt": {
      "types": "./dist/specs/verticals/apparel/tshirt/index.d.ts",
      "import": "./dist/specs/verticals/apparel/tshirt/index.mjs",
      "require": "./dist/specs/verticals/apparel/tshirt/index.js"
    },
    "./specs/verticals/apparel/tshirt/spec": {
      "types": "./dist/specs/verticals/apparel/tshirt/spec.d.ts",
      "import": "./dist/specs/verticals/apparel/tshirt/spec.mjs",
      "require": "./dist/specs/verticals/apparel/tshirt/spec.js"
    },
    "./specs/verticals/apparel/tshirt/artifacts": {
      "types": "./dist/specs/verticals/apparel/tshirt/artifacts.d.ts",
      "import": "./dist/specs/verticals/apparel/tshirt/artifacts.mjs",
      "require": "./dist/specs/verticals/apparel/tshirt/artifacts.js"
    },
    "./specs/verticals/apparel/tshirt/enums": {
      "types": "./dist/specs/verticals/apparel/tshirt/enums.d.ts",
      "import": "./dist/specs/verticals/apparel/tshirt/enums.mjs",
      "require": "./dist/specs/verticals/apparel/tshirt/enums.js"
    },
    "./specs/verticals/apparel/tshirt/zod-schemas": {
      "types": "./dist/specs/verticals/apparel/tshirt/zod-schemas.d.ts",
      "import": "./dist/specs/verticals/apparel/tshirt/zod-schemas.mjs",
      "require": "./dist/specs/verticals/apparel/tshirt/zod-schemas.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "a2a-protocol",
    "commerce-protocol",
    "cgent-ai",
    "typescript",
    "e-commerce",
    "protocol"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgent-ai/cgent-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/cgent-ai/cgent-protocol/issues"
  },
  "homepage": "https://github.com/cgent-ai/cgent-protocol#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}

